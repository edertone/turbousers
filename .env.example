# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (used both locally and by docker-compose via .env)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=usersvc
POSTGRES_PASSWORD=usersvc_password
POSTGRES_DB=usersvc
DATABASE_URL=postgresql://usersvc:usersvc_password@localhost:5432/usersvc?schema=public

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123
DASHBOARD_SECRET=change_me_dashboard_secret

# Cookies: set to true only when serving over HTTPS
COOKIE_SECURE=false